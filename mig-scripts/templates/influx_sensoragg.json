{
  "name": "influx_sensoragg",
  "bench_template": "python3 experiment/migration/influxdb/bench_sensoragg.py --threads {threads} --payload-mode {payload_mode} --rps {rate} --duration {duration} --payload-size {payload}",
  "rps_list": "40,160,400",
  "payload_sizes": "512B,2KB,6KB",
  "payload_modes": "json",
  "patterns": "random,zeros",
  "duration": 90,
  "threads": 4,
  "runs": 3,
  "container": "influxdb",
  "output": "results/influx_sensoragg_matrix.csv",
  "log_dir": "logs/influx_sensoragg"
}
